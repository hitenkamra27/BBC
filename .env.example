# Copy this file to .env (for local dev) and fill in your own values.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend (transactional emails — password resets, wholesale approval, order
# confirmations), sent via Resend's SMTP relay. Read server-side by
# server.js, NOT exposed to the browser, so it does NOT need a VITE_ prefix.
# Optional — you can instead set these in Admin → Website content →
# Integrations, but env vars here always take priority and stay private.
# Get the API key from resend.com → API Keys.
RESEND_API_KEY=re_your_resend_api_key
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=465
