# Copy this file to .env (for local dev) and fill in your own values.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Resend (transactional emails — password resets, wholesale approval, order
# confirmations). Read server-side by server.js, NOT exposed to the browser,
# so it does NOT need a VITE_ prefix. Get this from resend.com → API Keys.
RESEND_API_KEY=re_your_resend_api_key
